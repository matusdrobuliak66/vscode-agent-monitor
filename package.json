{
  "name": "vscode-agent-monitor",
  "displayName": "VSCode Agent Monitor",
  "description": "Monitor agent-to-model interactions and scan for security vulnerabilities",
  "version": "0.1.0",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-agent-monitor.showDashboard",
        "title": "Agent Monitor: Show Dashboard"
      },
      {
        "command": "vscode-agent-monitor.showLogs",
        "title": "Agent Monitor: Show Logs"
      },
      {
        "command": "vscode-agent-monitor.clearData",
        "title": "Agent Monitor: Clear Data"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "build-rust": "cargo build --release",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "electron": "^28.3.3",
    "eslint": "^8.x",
    "typescript": "^5.3.0"
  },
  "dependencies": {}

}
